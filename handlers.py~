@router.message(F.text)
async def convert_handler(message: Message):
    """Конвертер с полной защитой от некорректного ввода."""
    text = message.text.strip()
    has_separator = re.search(r"\b(в|to|in)\b", text, re.IGNORECASE)

    pattern = r"^(\S+)\s+(\S+)\s+(?:в|to|in)\s+(\S+)$"
    match = re.match(pattern, text, re.IGNORECASE)

    if not match:
        if has_separator:
            await message.answer(
                "⚠️ *Неверный формат команды!*\n\n"
                "Используйте формат: `100 usd в uzs`\n"
                "Нажмите «🧮 Как пользоваться калькулятором» в меню для справки.",
                parse_mode="Markdown",
                reply_markup=get_back_to_menu_keyboard()
            )
        return

    raw_amount, raw_from, raw_to = match.group(1), match.group(2).upper(), match.group(3).upper()

    # 1. Валидация числа
    try:
        amount = float(raw_amount.replace(",", "."))
        if amount <= 0:
            await message.answer(
                "⚠️ Сумма должна быть больше нуля!",
                reply_markup=get_back_to_menu_keyboard()
            )
            return
        if amount > 1_000_000_000_000:
            await message.answer(
                "⚠️ Слишком большая сумма для расчета.",
                reply_markup=get_back_to_menu_keyboard()
            )
            return
    except ValueError:
        await message.answer(
            f"⚠️ `{raw_amount}` не является корректным числом.",
            parse_mode="Markdown",
            reply_markup=get_back_to_menu_keyboard()
        )
        return

    # 2. Поиск валют
    from_curr = ALIASES.get(raw_from)
    to_curr = ALIASES.get(raw_to)

    unknown = []
    if not from_curr:
        unknown.append(f"«{raw_from}»")
    if not to_curr:
        unknown.append(f"«{raw_to}»")

    if unknown:
        await message.answer(
            f"⚠️ Не удалось распознать: {', '.join(unknown)}\n\n"
            f"{SUPPORTED_LIST_TEXT}",
            parse_mode="Markdown",
            reply_markup=get_back_to_menu_keyboard()
        )
        return

    # 3. Загрузка курсов
    fiat_rates = await get_fiat_rates()
    crypto_rates = await get_crypto_rates()

    def to_usd_rate(code: str) -> float | None:
        if code in crypto_rates:
            return crypto_rates[code]
        if code == "USD":
            return 1.0
        if code in fiat_rates and fiat_rates.get("USD"):
            return fiat_rates[code] / fiat_rates["USD"]
        return None

    rate_from = to_usd_rate(from_curr)
    rate_to = to_usd_rate(to_curr)

    if not rate_from or not rate_to:
        await message.answer(
            "⚠️ Временная ошибка сервера курсов. Попробуйте через 1-2 минуты.",
            reply_markup=get_back_to_menu_keyboard()
        )
        return

    # 4. Расчет
    amount_in_usd = amount * rate_from
    result = amount_in_usd / rate_to

    def fmt(val: float, code: str) -> str:
        if code in ("UZS", "KZT"):
            return f"{val:,.0f}"
        if code in ("BTC", "ETH"):
            return f"{val:.6f}" if val < 1 else f"{val:,.4f}"
        return f"{val:,.2f}"

    await message.answer(
        f"💱 *Результат конвертации:*\n"
        f"`{fmt(amount, from_curr)} {from_curr}` = *{fmt(result, to_curr)} {to_curr}*",
        parse_mode="Markdown",
        reply_markup=get_back_to_menu_keyboard()
    )