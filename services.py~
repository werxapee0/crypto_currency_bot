import aiohttp


async def get_fiat_rates() -> dict:
    """
    Получает курсы валют ЦБ РФ.
    Возвращает стоимость 1 единицы валюты в рублях (RUB).
    """
    url = "https://www.cbr-xml-daily.ru/daily_json.js"
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=5) as response:
                if response.status == 200:
                    data = await response.json(content_type=None)
                    valute = data.get("Valute", {})

                    def get_single_rate(code: str) -> float:
                        item = valute.get(code, {})
                        nominal = item.get("Nominal", 1)
                        value = item.get("Value", 0.0)
                        return value / nominal if nominal else 0.0

                    return {
                        "RUB": 1.0,
                        "USD": get_single_rate("USD"),
                        "EUR": get_single_rate("EUR"),
                        "CNY": get_single_rate("CNY"),
                        "UZS": get_single_rate("UZS"),  # Стоимость 1 сума в рублях
                    }
    except Exception as e:
        print(f"Ошибка получения фиатных валют: {e}")
    return {}


async def get_crypto_rates() -> dict:
    """Получает курсы криптовалют в USD через CoinGecko API."""
    url = "https://api.coingecko.com/api/v3/simple/price"
    params = {
        "ids": "bitcoin,ethereum,the-open-network,solana",
        "vs_currencies": "usd"
    }
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, params=params, timeout=5) as response:
                if response.status == 200:
                    data = await response.json()
                    return {
                        "BTC": data.get("bitcoin", {}).get("usd", 0.0),
                        "ETH": data.get("ethereum", {}).get("usd", 0.0),
                        "TON": data.get("the-open-network", {}).get("usd", 0.0),
                        "SOL": data.get("solana", {}).get("usd", 0.0),
                    }
    except Exception as e:
        print(f"Ошибка получения крипты: {e}")
    return {}